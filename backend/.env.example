# Aegis Proxy — Backend Environment Configuration
ENV=development

# Cryptographic Master Secrets (Generate with python scripts/generate_secrets.py)
HMAC_SECRET=super-secret-hmac-key-change-me
MASTER_VAULT_SECRET=super-secret-vault-key-change-me

# Session & CORS
DEFAULT_TTL_SECONDS=600
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
AUTH_FAILURE_RATE_LIMIT_PER_MINUTE=10

# Upstream LLM Provider (Groq Default)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_DEFAULT_MODEL=llama-3.3-70b-versatile
USE_MOCK_LLM=false

# ML Prompt Injection Detector (Optional Hugging Face DistilBERT — disabled by default to stay under 512MB RAM)
ENABLE_ML_DETECTOR=false

# Production Overrides for Demo API Keys (Leave blank for local development / demo defaults)
# ADMIN_KEY_SHA256=
# VIEWER_KEY_SHA256=
